{
  "name": "ngan-keo-studio",
  "version": "1.0.0",
  "description": "Web app chạy local để sản xuất video hoài niệm 8x/9x phong cách phim cũ, dựng trên Remotion",
  "type": "module",
  "bin": {
    "ngan-keo-studio": "bin/ngan-keo-studio.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"tsx watch src/server/dev.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json && tsx scripts/bundle-video.ts",
    "start": "node bin/ngan-keo-studio.js",
    "studio": "remotion studio src/remotion/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "package": "npm run build && npm pack"
  },
  "dependencies": {
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "express": "^4.21.0",
    "multer": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
